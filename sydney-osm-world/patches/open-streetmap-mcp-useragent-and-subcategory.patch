@@ -153,8 +163,10 @@ class OSMClient:
         
         # Build query for specified category and subcategories
         if subcategories:
-            subcategory_filters = " or ".join([f'"{category}"="{sub}"' for sub in subcategories])
-            query_filter = f'({subcategory_filters})'
+            # Overpass QL: a bare "(k=v or k=v)" key filter is a parse error.
+            # Use a regex match on the category key instead.
+            subcategory_filters = "|".join([sub for sub in subcategories])
+            query_filter = f'"{category}"~"^({subcategory_filters})$"'
         else:
