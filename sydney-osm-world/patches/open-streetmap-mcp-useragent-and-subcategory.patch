+# --- Sydney-OSM-World local patch (see patches/*.patch and docs/OSM-MCP.md) ---
+# 1. Overpass API (and other OSM services) reject requests without a descriptive
+#    User-Agent with HTTP 406. Upstream only sent a User-Agent to Nominatim.
+# 2. `search_category(subcategories=[...])` built invalid Overpass QL
+#    (`node[("amenity"="bar" or "amenity"="pub")]` -> HTTP 400 parse error).
+HTTP_HEADERS = {
+    "User-Agent": "Sydney-OSM-World/0.1 (OSM MCP world-building pipeline; +https://github.com/jagan-shanmugam/open-streetmap-mcp)"
+}
+
+
